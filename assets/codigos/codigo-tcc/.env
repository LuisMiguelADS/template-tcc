# Imagens
BUILD_IMAGE=maven:3.9-eclipse-temurin-25
RUNTIME_IMAGE=eclipse-temurin:25-jre
K6_IMAGE=grafana/k6:1.8.3

# Recursos idênticos para mvc, webflux e vt 
API_CPUS=2
API_MEM=1536m
API_JVM_OPTS="-XX:+UseG1GC -Xms768m -Xmx768m -XX:MaxDirectMemorySize=256m -XX:+ExitOnOutOfMemoryError"

# Banco simulado
MOCK_CPUS=2
MOCK_MEM=1g
MOCK_JVM_OPTS="-XX:+UseG1GC -Xms256m -Xmx256m -XX:MaxDirectMemorySize=256m -XX:+ExitOnOutOfMemoryError"
DB_LATENCY_MS=50
DB_JITTER_MS=0

# Cliente HTTP em consulta com o banco
DOWNSTREAM_MAX_CONNECTIONS=20000
DOWNSTREAM_TIMEOUT_MS=30000
TOMCAT_MAX_THREADS=200

# Gerador de carga para os testes
K6_CPUS=4
# API alvo do k6: mvc, webflux ou vt
API=mvc
USERS=100
QUERIES=3
RAMP_SEC=20
WARMUP_SEC=30
MEASUREMENT_SEC=120

LOAD_MODEL=closed
RATE_RPS=1000
THINK_MS=0
RUN_ID=manual
OUT_DIR=/resultados
